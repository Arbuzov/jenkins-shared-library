node('master') {
    stage('checkout') {
        checkout scm
    }
    stage('add builds') {
        jobDsl targets: ['vars/**.groovy', 'firmware/kernel-7000/build.groovy'].join('\n'),
           removedJobAction: 'DELETE',
           removedViewAction: 'DELETE',
           lookupStrategy: 'SEED_JOB',
           additionalParameters: [WORKSPACE:  pwd()]
    }
    stage('get diff') {
        build job: 'compare-builds',
            parameters : [
                [$class: 'StringParameterValue', name: 'JOB1', value: 'kernel-7000'],
                [$class: 'StringParameterValue', name: 'JOB2', value: 'kernel-7000-autogenerated']
            ]
    }
}