node('master') {
	stage('checkout') {
		checkout scm
	}
	stage('add builds') {
		jobDsl targets: ['firmware/yocto/build.groovy', 'firmware/build.groovy'].join('\n'),
			removedJobAction: 'DELETE',
			removedViewAction: 'DELETE',
			lookupStrategy: 'SEED_JOB',
			additionalParameters: [WORKSPACE:  pwd()],
			additionalClasspath: ['vars/*.groovy'].join('\n')
	}
	stage('get diff') {
		build job: 'compare-builds',
			parameters : [
				[$class: 'StringParameterValue', name: 'JOB1', value: 'yocto-rebuild'],
				[$class: 'StringParameterValue', name: 'JOB2', value: 'yocto-rebuild-autogenerated']
			]
	}
}